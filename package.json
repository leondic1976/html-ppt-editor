{
  "name": "html-ppt-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hps/editor-web dev",
    "build": "pnpm --filter @hps/editor-web build",
    "preview": "pnpm --filter @hps/editor-web preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "scan": "tsx scripts/scan.ts",
    "fixtures": "node scripts/build-fixtures.mjs",
    "deck-to-pdf": "tsx scripts/deck-to-pdf.ts",
    "schema": "tsx scripts/export-schema.ts",
    "poc:pptx": "vitest run --config scripts/vitest.scripts.ts poc-b",
    "boundaries": "node scripts/check-boundaries.mjs",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
